<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drims_homework</name>
  <version>0.0.0</version>
  <description>DRIMS2 - Homework</description>
  <maintainer email="samuele.sandrini@stiima.cnr.it">kalman</maintainer>
  <license>Apache License 2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>easy_motion</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- Only for dice_simulator_start.launch.py, which wraps this
       package's own spawn_dice.launch.py + a start-up race healer (see
       dice_simulator_healer.py). Not a hard build dependency: this
       package builds and runs fine without drims_dice_simulator
       overlaid, as long as that convenience launch file is not used. -->
  <exec_depend>drims_dice_simulator</exec_depend>

  <depend>easy_motion_behavior_tree</depend>
  <depend>easy_motion_msgs</depend>
  <depend>easy_motion_cpp</depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
